# Variables de entorno y configuraciones locales
.env
.env.*
*.local
# Las plantillas pueden versionarse, siempre sin credenciales reales.
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Dependencias (package-lock.json sí se versiona)
node_modules/

# Compilación de Vite
/dist/
/dist-ssr/

# Cachés y archivos temporales de herramientas
/.vite/
/.vite-temp/
*.timestamp-*.mjs
*.tsbuildinfo
.eslintcache

# Cobertura generada (las pruebas y snapshots de referencia se versionan)
/coverage/
/artifacts/rls/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Configuración personal de editores; conservar extensiones recomendadas
.vscode/*
!.vscode/extensions.json
.idea/
.vs/
*.suo
*.swp
*.swo
*~

# Archivos del sistema operativo
.DS_Store
Thumbs.db
Desktop.ini
