# Copiar a .env.rls.local. Nunca usar el proyecto principal ni una copia con datos reales.
RLS_SUPABASE_URL=https://REEMPLAZAR_REF_TEST.supabase.co
RLS_TEST_PROJECT_REF=
RLS_PRIMARY_SUPABASE_URL=
RLS_CONFIRM_TEST_ONLY=
# Confirmación exacta requerida: TEST_ONLY:<RLS_TEST_PROJECT_REF>
# Si el único proyecto está dedicado SOLO a pruebas y NO contiene datos reales,
# autorizar explícitamente por ejecución: npm run test:rls -- --single-project-test-only
# Solo en ese modo la URL principal es opcional y se admite coincidencia con la app.
RLS_SUPABASE_PUBLISHABLE_KEY=
RLS_USER_A_EMAIL=
RLS_USER_A_PASSWORD=
RLS_USER_B_EMAIL=
RLS_USER_B_PASSWORD=
RLS_ADMIN_EMAIL=
RLS_ADMIN_PASSWORD=
