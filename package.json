{
  "name": "recetapis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "run-s test:unit test:legacy",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node --test tests/*.test.js",
    "test:rls": "node tools/test-rls.mjs",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "axios": "^1.21.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
